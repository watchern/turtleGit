{
  "name": "turtlegit",
  "displayName": "TurtleGit - TortoiseGit 风格的跨平台 Git 增强",
  "description": "在 VSCode 中复刻 TortoiseGit 的提交、浏览、对比体验：独立浮窗对话框、提交图、按块勾选提交。纯插件实现，不依赖 TortoiseGit，Linux/macOS/Windows 通用。",
  "version": "0.3.22",
  "publisher": "turtlegit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/turtlegit/turtlegit.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "tortoisegit",
    "commit",
    "log",
    "diff"
  ],
  "activationEvents": [
    "workspaceContains:.git",
    "onCommand:turtlegit.commit",
    "onCommand:turtlegit.commitPath",
    "onCommand:turtlegit.log",
    "onCommand:turtlegit.diff",
    "onCommand:turtlegit.diffPanel",
    "onCommand:turtlegit.openFile",
    "onCommand:turtlegit.stage",
    "onCommand:turtlegit.unstage",
    "onCommand:turtlegit.discard",
    "onCommand:turtlegit.ignore",
    "onCommand:turtlegit.graph",
    "onCommand:turtlegit.stash",
    "onCommand:turtlegit.blame",
    "onCommand:turtlegit.refresh",
    "onCommand:turtlegit.openFloating",
    "onCommand:turtlegit.pull",
    "onCommand:turtlegit.push",
    "onView:turtlegit.sidebarView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "turtlegit.commit",
        "title": "提交… (Commit)",
        "category": "TurtleGit",
        "icon": "$(check)"
      },
      {
        "command": "turtlegit.commitPath",
        "title": "在此提交… (Commit Here)",
        "category": "TurtleGit"
      },
      {
        "command": "turtlegit.branches",
        "title": "分支… (Branches)",
        "category": "TurtleGit",
        "icon": "$(git-branch)"
      },
      {
        "command": "turtlegit.openFile",
        "title": "在编辑器中打开 (Open in Editor)",
        "category": "TurtleGit"
      },
      {
        "command": "turtlegit.stage",
        "title": "暂存 (Stage)",
        "category": "TurtleGit"
      },
      {
        "command": "turtlegit.unstage",
        "title": "取消暂存 (Unstage)",
        "category": "TurtleGit"
      },
      {
        "command": "turtlegit.discard",
        "title": "放弃修改 (Revert)",
        "category": "TurtleGit"
      },
      {
        "command": "turtlegit.ignore",
        "title": "添加到 .gitignore (Add to Ignore List)",
        "category": "TurtleGit"
      },
      {
        "command": "turtlegit.log",
        "title": "显示日志… (Show Log)",
        "category": "TurtleGit",
        "icon": "$(git-commit)"
      },
      {
        "command": "turtlegit.diff",
        "title": "比较差异… (Diff)",
        "category": "TurtleGit",
        "icon": "$(diff)"
      },
      {
        "command": "turtlegit.diffPanel",
        "title": "比较差异（增强面板）… (Diff Panel)",
        "category": "TurtleGit"
      },
      {
        "command": "turtlegit.graph",
        "title": "版本分支图… (Revision Graph)",
        "category": "TurtleGit",
        "icon": "$(git-branch)"
      },
      {
        "command": "turtlegit.stash",
        "title": "存储… (Stash)",
        "category": "TurtleGit",
        "icon": "$(archive)"
      },
      {
        "command": "turtlegit.blame",
        "title": "追溯… (Blame)",
        "category": "TurtleGit",
        "icon": "$(person)"
      },
      {
        "command": "turtlegit.refresh",
        "title": "刷新 (Refresh)",
        "category": "TurtleGit",
        "icon": "$(refresh)"
      },
      {
        "command": "turtlegit.openFloating",
        "title": "收回主窗口 (Pull Panel Back to Main Window)",
        "category": "TurtleGit"
      },
      {
        "command": "turtlegit.pull",
        "title": "拉取 (Pull)",
        "category": "TurtleGit",
        "icon": "$(arrow-down)"
      },
      {
        "command": "turtlegit.push",
        "title": "推送 (Push)",
        "category": "TurtleGit",
        "icon": "$(arrow-up)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "turtlegit.commitPath",
          "when": "resourceLangId != '' || !explorerResourceIsFolder",
          "group": "2_turtlegit@1"
        },
        {
          "command": "turtlegit.log",
          "when": "!explorerResourceIsFolder",
          "group": "2_turtlegit@2"
        },
        {
          "command": "turtlegit.diff",
          "when": "!explorerResourceIsFolder",
          "group": "2_turtlegit@3"
        },
        {
          "command": "turtlegit.blame",
          "when": "!explorerResourceIsFolder",
          "group": "2_turtlegit@4"
        },
        {
          "command": "turtlegit.graph",
          "group": "2_turtlegit@5"
        },
        {
          "command": "turtlegit.stash",
          "group": "2_turtlegit@6"
        },
        {
          "command": "turtlegit.branches",
          "when": "!explorerResourceIsFolder",
          "group": "2_turtlegit@7"
        }
      ],
      "editor/context": [
        {
          "command": "turtlegit.commitPath",
          "group": "2_turtlegit@1"
        },
        {
          "command": "turtlegit.log",
          "group": "2_turtlegit@2"
        },
        {
          "command": "turtlegit.diff",
          "group": "2_turtlegit@3"
        },
        {
          "command": "turtlegit.blame",
          "group": "2_turtlegit@4"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "turtlegit.commitPath",
          "group": "2_turtlegit@1"
        },
        {
          "command": "turtlegit.diff",
          "group": "2_turtlegit@2"
        }
      ],
      "editor/title/run": [
        {
          "command": "turtlegit.commit",
          "group": "navigation@-1"
        }
      ],
      "view/title": [
        {
          "command": "turtlegit.log",
          "when": "view == turtlegit.sidebarView",
          "group": "2_more@1"
        },
        {
          "command": "turtlegit.graph",
          "when": "view == turtlegit.sidebarView",
          "group": "2_more@2"
        },
        {
          "command": "turtlegit.pull",
          "when": "view == turtlegit.sidebarView",
          "group": "2_more@3"
        },
        {
          "command": "turtlegit.push",
          "when": "view == turtlegit.sidebarView",
          "group": "2_more@4"
        }
      ]
    },
    "keybindings": [
      {
        "command": "turtlegit.refresh",
        "key": "f5",
        "when": "webviewFocus"
      }
    ],
    "configuration": {
      "title": "TurtleGit",
      "properties": {
        "turtlegit.gitPath": {
          "type": "string",
          "default": "",
          "description": "git 可执行文件路径。留空则自动探测（PATH、TortoiseGit 自带 git、Git for Windows）。"
        },
        "turtlegit.panelMode": {
          "type": "string",
          "enum": [
            "auto",
            "floating",
            "embedded"
          ],
          "enumDescriptions": [
            "自动：优先浮动独立窗口，不可用时降级为编辑器内标签页",
            "浮动窗口：将对话框移到独立 OS 窗口（最接近 TortoiseGit）",
            "内嵌：固定在编辑器区域标签页（最稳）"
          ],
          "default": "auto",
          "description": "对话框的打开方式。"
        },
        "turtlegit.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "仓库变化时自动刷新对话框内容。"
        },
        "turtlegit.showStatusDecorations": {
          "type": "boolean",
          "default": true,
          "description": "在资源管理器中显示文件状态角标（复刻 TortoiseGit 图标覆盖）。"
        },
        "turtlegit.ignoredExcludeDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".history",
            "node_modules"
          ],
          "description": "勾选「忽略文件」时排除不显示的文件夹。按目录名或仓库相对路径匹配（如 .history、node_modules、dist/build；目录名匹配对任意层级生效）。设为空数组则全部显示。"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "turtlegit",
          "title": "TurtleGit",
          "icon": "resources/turtle.svg"
        }
      ]
    },
    "views": {
      "turtlegit": [
        {
          "type": "webview",
          "id": "turtlegit.sidebarView",
          "name": ""
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "build": "node esbuild.js --production",
    "test": "esbuild test/smoke.ts --bundle --platform=node --format=cjs --outfile=dist-test/smoke.cjs && node dist-test/smoke.cjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
