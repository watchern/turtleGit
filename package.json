{
  "name": "turtlegit",
  "displayName": "%ext.displayName%",
  "description": "%ext.description%",
  "version": "0.5.1",
  "packageManager": "pnpm@11.24.0",
  "publisher": "turtlegit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/turtlegit/turtlegit.git"
  },
  "engines": {
    "vscode": "^1.52.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "tortoisegit",
    "commit",
    "log",
    "diff"
  ],
  "activationEvents": [
    "workspaceContains:.git",
    "onCommand:turtlegit.commit",
    "onCommand:turtlegit.commitPath",
    "onCommand:turtlegit.log",
    "onCommand:turtlegit.diff",
    "onCommand:turtlegit.diffPanel",
    "onCommand:turtlegit.openFile",
    "onCommand:turtlegit.stage",
    "onCommand:turtlegit.unstage",
    "onCommand:turtlegit.discard",
    "onCommand:turtlegit.ignore",
    "onCommand:turtlegit.graph",
    "onCommand:turtlegit.stash",
    "onCommand:turtlegit.blame",
    "onCommand:turtlegit.refresh",
    "onCommand:turtlegit.openFloating",
    "onCommand:turtlegit.pull",
    "onCommand:turtlegit.push",
    "onView:turtlegit.sidebarView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "turtlegit.commit",
        "title": "%cmd.commit.title%",
        "category": "TurtleGit",
        "icon": "$(check)"
      },
      {
        "command": "turtlegit.commitPath",
        "title": "%cmd.commitPath.title%",
        "category": "TurtleGit"
      },
      {
        "command": "turtlegit.branches",
        "title": "%cmd.branches.title%",
        "category": "TurtleGit",
        "icon": "$(git-branch)"
      },
      {
        "command": "turtlegit.openFile",
        "title": "%cmd.openFile.title%",
        "category": "TurtleGit"
      },
      {
        "command": "turtlegit.stage",
        "title": "%cmd.stage.title%",
        "category": "TurtleGit"
      },
      {
        "command": "turtlegit.unstage",
        "title": "%cmd.unstage.title%",
        "category": "TurtleGit"
      },
      {
        "command": "turtlegit.discard",
        "title": "%cmd.discard.title%",
        "category": "TurtleGit"
      },
      {
        "command": "turtlegit.ignore",
        "title": "%cmd.ignore.title%",
        "category": "TurtleGit"
      },
      {
        "command": "turtlegit.log",
        "title": "%cmd.log.title%",
        "category": "TurtleGit",
        "icon": "$(git-commit)"
      },
      {
        "command": "turtlegit.diff",
        "title": "%cmd.diff.title%",
        "category": "TurtleGit",
        "icon": "$(diff)"
      },
      {
        "command": "turtlegit.diffPanel",
        "title": "%cmd.diffPanel.title%",
        "category": "TurtleGit"
      },
      {
        "command": "turtlegit.graph",
        "title": "%cmd.graph.title%",
        "category": "TurtleGit",
        "icon": "$(git-branch)"
      },
      {
        "command": "turtlegit.stash",
        "title": "%cmd.stash.title%",
        "category": "TurtleGit",
        "icon": "$(archive)"
      },
      {
        "command": "turtlegit.blame",
        "title": "%cmd.blame.title%",
        "category": "TurtleGit",
        "icon": "$(person)"
      },
      {
        "command": "turtlegit.refresh",
        "title": "%cmd.refresh.title%",
        "category": "TurtleGit",
        "icon": "$(refresh)"
      },
      {
        "command": "turtlegit.openFloating",
        "title": "%cmd.openFloating.title%",
        "category": "TurtleGit"
      },
      {
        "command": "turtlegit.pull",
        "title": "%cmd.pull.title%",
        "category": "TurtleGit",
        "icon": "$(arrow-down)"
      },
      {
        "command": "turtlegit.push",
        "title": "%cmd.push.title%",
        "category": "TurtleGit",
        "icon": "$(arrow-up)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "turtlegit.commitPath",
          "when": "resourceLangId != '' || !explorerResourceIsFolder",
          "group": "2_turtlegit@1"
        },
        {
          "command": "turtlegit.log",
          "when": "!explorerResourceIsFolder",
          "group": "2_turtlegit@2"
        },
        {
          "command": "turtlegit.diff",
          "when": "!explorerResourceIsFolder",
          "group": "2_turtlegit@3"
        },
        {
          "command": "turtlegit.blame",
          "when": "!explorerResourceIsFolder",
          "group": "2_turtlegit@4"
        },
        {
          "command": "turtlegit.graph",
          "group": "2_turtlegit@5"
        },
        {
          "command": "turtlegit.stash",
          "group": "2_turtlegit@6"
        },
        {
          "command": "turtlegit.branches",
          "when": "!explorerResourceIsFolder",
          "group": "2_turtlegit@7"
        }
      ],
      "editor/context": [
        {
          "command": "turtlegit.commitPath",
          "group": "2_turtlegit@1"
        },
        {
          "command": "turtlegit.log",
          "group": "2_turtlegit@2"
        },
        {
          "command": "turtlegit.diff",
          "group": "2_turtlegit@3"
        },
        {
          "command": "turtlegit.blame",
          "group": "2_turtlegit@4"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "turtlegit.commitPath",
          "group": "2_turtlegit@1"
        },
        {
          "command": "turtlegit.diff",
          "group": "2_turtlegit@2"
        }
      ],
      "editor/title/run": [
        {
          "command": "turtlegit.commit",
          "group": "navigation@-1"
        }
      ],
      "view/title": [
        {
          "command": "turtlegit.log",
          "when": "view == turtlegit.sidebarView",
          "group": "2_more@1"
        },
        {
          "command": "turtlegit.graph",
          "when": "view == turtlegit.sidebarView",
          "group": "2_more@2"
        },
        {
          "command": "turtlegit.pull",
          "when": "view == turtlegit.sidebarView",
          "group": "2_more@3"
        },
        {
          "command": "turtlegit.push",
          "when": "view == turtlegit.sidebarView",
          "group": "2_more@4"
        }
      ]
    },
    "keybindings": [
      {
        "command": "turtlegit.refresh",
        "key": "f5",
        "when": "webviewFocus"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "turtlegit.language": {
          "type": "string",
          "enum": [
            "auto",
            "zh-hans",
            "zh-hant",
            "en"
          ],
          "enumDescriptions": [
            "%cfg.language.auto%",
            "%cfg.language.zhHans%",
            "%cfg.language.zhHant%",
            "%cfg.language.en%"
          ],
          "default": "auto",
          "description": "%cfg.language.description%"
        },
        "turtlegit.gitPath": {
          "type": "string",
          "default": "",
          "description": "%cfg.gitPath.description%"
        },
        "turtlegit.panelMode": {
          "type": "string",
          "enum": [
            "auto",
            "floating",
            "embedded"
          ],
          "enumDescriptions": [
            "%cfg.panelMode.auto%",
            "%cfg.panelMode.floating%",
            "%cfg.panelMode.embedded%"
          ],
          "default": "auto",
          "description": "%cfg.panelMode.description%"
        },
        "turtlegit.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.autoRefresh.description%"
        },
        "turtlegit.showStatusDecorations": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.showStatusDecorations.description%"
        },
        "turtlegit.ignoredExcludeDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".history",
            "node_modules"
          ],
          "description": "%cfg.ignoredExcludeDirs.description%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "turtlegit",
          "title": "TurtleGit",
          "icon": "resources/turtle.svg"
        }
      ]
    },
    "views": {
      "turtlegit": [
        {
          "type": "webview",
          "id": "turtlegit.sidebarView",
          "name": ""
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "build": "node esbuild.js --production",
    "test": "pnpm exec esbuild test/smoke.ts --bundle --platform=node --format=cjs --alias:vscode=./test/vscode-stub.ts --outfile=dist-test/smoke.cjs && node dist-test/smoke.cjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "1.52.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.24.0",
    "highlight.js": "^11.12.0",
    "typescript": "^5.6.0"
  }
}
